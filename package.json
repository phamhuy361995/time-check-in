    "lucide-react": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "concurrently": "^9.2.1",
    "postcss": "latest",
    "tailwindcss": "^3.4.17"
  }
