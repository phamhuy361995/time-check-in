# =========================
# Local development
# =========================
PORT=3001
POSTGRES_AUTO_MIGRATE=true
APP_TIMEZONE_OFFSET_MINUTES=420

# =========================
# Supabase Postgres
# Runtime trên Vercel phải dùng Transaction pooler URL (port 6543).
# Migration nên dùng direct/non-pooling URL (port 5432).
# =========================
POSTGRES_DATABASE=postgres
POSTGRES_HOST=db.rcrztqkvmbryljcimshy.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Pool của Node.js; giữ nhỏ vì Supabase đã có Supavisor pooler.
POSTGRES_POOL_MAX=5
POSTGRES_IDLE_TIMEOUT=10000
POSTGRES_CONNECT_TIMEOUT=10000

# require: luôn mã hóa TLS nhưng không xác minh CA; phù hợp để khắc phục lỗi
# SELF_SIGNED_CERT_IN_CHAIN. Dùng verify-full + POSTGRES_SSL_CA để bảo mật cao nhất.
POSTGRES_SSL_MODE=require

# Với verify-full: tải Server root certificate trong Supabase Database Settings,
# dán nội dung certificate vào đây và giữ xuống dòng bằng \\n.
POSTGRES_SSL_CA=

# =========================
# Supabase server-only secrets
# Không bao giờ thêm tiền tố VITE_ cho các biến này.
# Backend hiện kết nối bằng POSTGRES_URL; các key dưới đây dành cho Auth/Data API sau này.
# =========================
SUPABASE_URL=https://rcrztqkvmbryljcimshy.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# =========================
# Frontend-safe Supabase config
# Chỉ publishable/anon key được phép xuất hiện trong bundle Vite.
# URL phải là chuỗi thuần, không viết [https://...](https://...).
# =========================
VITE_PUBLIC_SUPABASE_URL=https://rcrztqkvmbryljcimshy.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# =========================
# Frontend -> Express API
# Local: để trống để Vite proxy /api tới http://localhost:3001.
# Vercel Frontend Project: https://<backend-project>.vercel.app
# =========================
VITE_API_URL=

# Backend CORS: nhiều frontend URL được phân cách bằng dấu phẩy.
CLIENT_ORIGINS=http://localhost:5173
