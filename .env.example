# =========================
# Local development
# =========================
PORT=3001
DB_AUTO_MIGRATE=true

# =========================
# MySQL connection
# DB_HOST phải là hostname công khai của managed MySQL khi deploy Vercel,
# không dùng 127.0.0.1 hoặc localhost trên Production.
# =========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=time_check_in
DB_SSL=false
# Nếu provider cấp CA certificate, giữ nguyên xuống dòng bằng ký tự \\n.
DB_SSL_CA=
DB_CONNECTION_LIMIT=5
DB_IDLE_TIMEOUT=10000
DB_CONNECT_TIMEOUT=10000

# Múi giờ Việt Nam (UTC+7)
APP_TIMEZONE_OFFSET_MINUTES=420

# =========================
# Backend CORS
# Có thể khai báo nhiều frontend URL, phân cách bằng dấu phẩy.
# Production example:
# CLIENT_ORIGINS=https://time-check-in.vercel.app,https://time-check-in-git-main.vercel.app
# =========================
CLIENT_ORIGINS=http://localhost:5173

# =========================
# Frontend build-time config
# Local: để trống để Vite proxy /api tới http://localhost:3001.
# Vercel Frontend Project: đặt URL của Backend Project, không có dấu / cuối.
# Example: https://time-check-in-api.vercel.app
# =========================
VITE_API_URL=
